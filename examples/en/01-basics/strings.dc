# Working with strings
# Demonstration of string operations

let greeting = "Hello"
let name = "DataCode"
let message = greeting + ", " + name + "!"

print(message)

# String length
let text = "Hello, World!"
let length = len(text)

print("Text: " + text)
print("Length: " + length)

# Empty string
let empty = ""
let empty_len = len(empty)
print("Empty string, length: " + empty_len)

# Concatenation with numbers (via strings)
let num = 42
let num_str = "Number: " + "42"
print(num_str)

# String slices s[start:stop:step] (Unicode character indices)
let s = "Hello, World!"
print("s[1:4] = " + s[1:4])
print("s[-3:] = " + s[-3:])
print("s[::2] = " + s[::2])

