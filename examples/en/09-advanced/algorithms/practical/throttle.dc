# Throttle - no more than one call per interval

cls Throttler {
    private:
        interval_ms: int
        last_fired_ms: float
        call_count: int

    new Throttler(interval_ms: int) {
        this.interval_ms = interval_ms
        this.last_fired_ms = -1000000.0
        this.call_count = 0
    }

    public:
    fn invoke(now_ms: float, value: str) -> Optional[str] {
        """
        Execute a callback only if >= interval_ms has passed since the last call.
        Otherwise return null.
        """
        if now_ms - this.last_fired_ms >= this.interval_ms {
            this.last_fired_ms = now_ms
            this.call_count += 1
            return value
        }
        return null
    }

    fn count() -> int { return this.call_count }
}

fn __main__() {
    print("=== Throttle ===")

    th = Throttler(100)
    fired = []

    for t in [0.0, 30.0, 60.0, 150.0, 200.0, 250.0] {
        val = th.invoke(t, "tick@${t}")
        if val != null { fired.push(val) }
    }

    print("calls: ${fired}")
    print("number of operations: ${th.count()} (expected 3)")

    status = if th.count() == 3 { "OK" } else { "FAIL" }
    print("Test: ${status}")
}
