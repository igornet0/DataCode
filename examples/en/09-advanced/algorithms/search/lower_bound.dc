# lower_bound is the first index of i, where arr[i] >= target (like std::lower_bound)

fn lower_bound(arr: list[int], target: int) -> int {
    lo = 0
    hi = len(arr)

    while lo < hi {
        mid = lo + (hi - lo) // 2
        if arr[mid] < target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

fn __main__() {
    print("=== Lower Bound ===")

    data = [1, 2, 2, 2, 3, 4, 5]
    tests = [
        (0, 0),
        (1, 0),
        (2, 1),
        (3, 4),
        (6, 7),
    ]

    print("Array: ${data}")
    for t in tests {
        target, expected = t[0], t[1]
        got = lower_bound(data, target)
        status = if got == expected { "OK" } else { "FAIL" }
        print("  ${status}: lower_bound(${target}) = ${got}, expected ${expected}")
    }
}
