# Quick sort (QuickSort, Lomuto) - O(n log n) on average

fn partition(arr: list[int], lo: int, hi: int) -> int {
    pivot = arr[hi]
    i = lo

    for j in range(lo, hi) {
        if arr[j] <= pivot {
            arr[i], arr[j] = arr[j], arr[i]
            i = i + 1
        }
    }
    arr[i], arr[hi] = arr[hi], arr[i]
    return i
}

fn quick_sort_inplace(arr: list[int], lo: int, hi: int) {
    if lo >= hi: return
    p = partition(arr, lo, hi)
    quick_sort_inplace(arr, lo, p - 1)
    quick_sort_inplace(arr, p + 1, hi)
}

fn quick_sort(arr: list[int]) -> list[int] {
    a = arr.clone()
    if len(a) > 0: quick_sort_inplace(a, 0, len(a) - 1)
    return a
}

fn __main__() {
    print("=== Quick Sort ===")

    tests = [
        [10, 7, 8, 9, 1, 5],
        [3, 3, 3],
        [42],
        [],
    ]

    for data in tests {
        result = quick_sort(data)
        print("  ${data} → ${result}")
    }

    data = [5, 1, 4, 2, 8, 0, 2, 9, 3, 7, 6]
    expected = sort(data.clone())
    got = quick_sort(data)
    print("\nComparison with sort(): ${got == expected}")
}
