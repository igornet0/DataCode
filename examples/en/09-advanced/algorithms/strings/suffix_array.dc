# Suffix array - sorting all suffixes in O(n² log n) (training version)

fn suffix_array(s: str) -> list[int] {
    """
    Returns an array of starting suffix indexes in lexicographical order.
    """
    n = len(s)
    suffixes = []
    for i in range(n) { suffixes.push((s[i:], i)) }
    suffixes = sort(suffixes)
    return [suffixes[i][1] for i in range(n)]
}

fn lcp_array(s: str, sa: list[int]) -> list[int] {
    """LCP array between adjacent suffixes in SA (simplified O(n²))."""
    n = len(sa)
    if n <= 1: return []

    lcp = []
    for i in range(n - 1) {
        a = sa[i]
        b = sa[i + 1]
        k = 0
        while a + k < len(s) and b + k < len(s) and s[a + k] == s[b + k] {
            k += 1
        }
        lcp.push(k)
    }
    return lcp
}

fn search_suffix_array(s: str, sa: list[int], pattern: str) -> Optional[int] {
    """First position of pattern in s via binary search on SA."""
    lo = 0
    hi = len(sa) - 1
    found = null

    while lo <= hi {
        mid = lo + (hi - lo) // 2
        suffix = s[sa[mid]:]
        if suffix[:len(pattern)] == pattern {
            found = sa[mid]
            hi = mid - 1
        } else if suffix < pattern {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return found
}

fn __main__() {
    print("=== Suffix Array ===")

    s = "banana"
    sa = suffix_array(s)
    lcp = lcp_array(s, sa)

    print("s='${s}'")
    print("SA: ${sa}")
    print("LCP: ${lcp}")

    pos = search_suffix_array(s, sa, "ana")
    print("search 'ana': position ${pos} (expected 1 or 3)")

    status = if len(sa) == len(s) and pos != null { "OK" } else { "FAIL" }
    print("Test: ${status}")
}
