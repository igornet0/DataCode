# AVL tree - self-balancing BST, height O(log n)

cls AvlNode {
    public:
        value: int
        height: int
        left: Optional[AvlNode]
        right: Optional[AvlNode]

    new AvlNode(value: int) {
        this.value = value
        this.height = 1
        this.left = null
        this.right = null
    }
}

fn node_height(node: Optional[AvlNode]) -> int {
    if node == null: return 0
    return node.height
}

fn balance_factor(node: Optional[AvlNode]) -> int {
    if node == null: return 0
    return node_height(node.left) - node_height(node.right)
}

fn update_height(node: AvlNode) {
    node.height = 1 + max(node_height(node.left), node_height(node.right))
}

fn rotate_right(y: AvlNode) -> AvlNode {
    x = y.left
    t2 = x.right
    x.right = y
    y.left = t2
    update_height(y)
    update_height(x)
    return x
}

fn rotate_left(x: AvlNode) -> AvlNode {
    y = x.right
    t2 = y.left
    y.left = x
    x.right = t2
    update_height(x)
    update_height(y)
    return y
}

fn avl_insert(node: Optional[AvlNode], value: int) -> AvlNode {
    if node == null: return AvlNode(value)

    if value < node.value {
        node.left = avl_insert(node.left, value)
    } else if value > node.value {
        node.right = avl_insert(node.right, value)
    } else {
        return node
    }

    update_height(node)
    bf = balance_factor(node)

    if bf > 1 and value < node.left.value { return rotate_right(node) }
    if bf < -1 and value > node.right.value { return rotate_left(node) }
    if bf > 1 and value > node.left.value {
        node.left = rotate_left(node.left)
        return rotate_right(node)
    }
    if bf < -1 and value < node.right.value {
        node.right = rotate_right(node.right)
        return rotate_left(node)
    }
    return node
}

fn avl_inorder(node: Optional[AvlNode], result: list[int]) {
    if node == null: return
    avl_inorder(node.left, result)
    result.push(node.value)
    avl_inorder(node.right, result)
}

fn __main__() {
    print("=== AVL Tree ===")

    root = null
    for x in [10, 20, 30, 40, 50, 25] { root = avl_insert(root, x) }

    sorted_vals = []
    avl_inorder(root, sorted_vals)
    print("inorder: ${sorted_vals}")
    print("root height: ${root.height}")

    status = if sorted_vals == [10, 20, 25, 30, 40, 50] { "OK" } else { "FAIL" }
    print("Test: ${status}")
}
