# Articulation points - Tarjan DFS
# Undirected graph: graph[u] = [v, ...]

cls ArticulationFinder {
    private:
        timer: int
        tin: dict[int, int]
        low: dict[int, int]
        visited: set[int]
        points: set[int]

    new ArticulationFinder() {
        this.timer = 0
        this.tin = {}
        this.low = {}
        this.visited = set()
        this.points = set()
    }

    public:
    fn dfs(graph: dict[int, list[int]], v: int, parent: int) {
        this.visited.add(v)
        this.timer = this.timer + 1
        this.tin[v] = this.timer
        this.low[v] = this.timer
        children = 0

        for to in graph.get(v, []) {
            if to == parent: continue

            if to in this.visited {
                this.low[v] = min(this.low[v], this.tin[to])
            } else {
                this.dfs(graph, to, v)
                this.low[v] = min(this.low[v], this.low[to])
                children = children + 1

                # DFS tree root with ≥2 children
                if parent == -1 and children >= 2 {
                    this.points.add(v)
                }
                # Non-root: child without path to ancestors v
                if parent != -1 and this.low[to] >= this.tin[v] {
                    this.points.add(v)
                }
            }
        }
    }

    fn find_points(graph: dict[int, array[int]], n: int) -> array[int] {
        for i in range(n) {
            if !(i in this.visited) {
                this.dfs(graph, i, -1)
            }
        }
        return sort(array(this.points))
    }
}

fn build_sample_graph() -> tuple[int, dict[int, array[int]]] {
    n = 7
    edges = [(0, 1), (1, 2), (2, 0), (1, 3), (3, 4), (4, 5), (5, 3), (3, 6)]
    graph = {}
    for i in range(n) { graph[i] = [] }
    for e in edges {
        u, v = e[0], e[1]
        graph[u].push(v)
        graph[v].push(u)
    }
    return (n, graph)
}

fn __main__() {
    print("=== Articulation Points ===")

    n, graph = build_sample_graph()
    finder = ArticulationFinder()
    points = finder.find_points(graph, n)

    print("Vertexes: ${n}")
    print("Articulation points: ${points}")

    expected = [1, 3]
    status = if points == expected { "OK" } else { "FAIL" }
    print("Test: ${status} (expected ${expected})")

    # Complete graph K4 - no articulation points
    k4 = {}
    for i in range(4) { k4[i] = [] }
    for i in range(4) {
        for j in range(i + 1, 4) {
            k4[i].push(j)
            k4[j].push(i)
        }
    }
    k4_points = ArticulationFinder().find_points(k4, 4)
    print("\nK4: points=${k4_points} (expected [])")
}
