# Detecting cycles in directed and undirected graphs

fn has_cycle_directed(graph: dict[int, array[int]]) -> bool {
    """
    DFS with three states: 0 - not visited, 1 - on the recursion stack, 2 - processed.
    """
    state = {}
    for v in graph.keys { state[v] = 0 }

    fn dfs(node: int) -> bool {
        state[node] = 1
        for nxt in graph.get(node, []) {
            if state.get(nxt, 0) == 1: return true
            if state.get(nxt, 0) == 0 and dfs(nxt): return true
        }
        state[node] = 2
        return false
    }

    for v in graph.keys {
        if state[v] == 0 and dfs(v): return true
    }
    return false
}

fn has_cycle_undirected(graph: dict[int, array[int]], n: int) -> bool {
    """DFS: back edge to ancestor (not parent) means cycle."""
    visited = set()

    fn dfs(node: int, parent: int) -> bool {
        visited.add(node)
        for nxt in graph.get(node, []) {
            if nxt == parent: continue
            if nxt in visited: return true
            if dfs(nxt, node): return true
        }
        return false
    }

    for i in range(n) {
        if !(i in visited) and dfs(i, -1): return true
    }
    return false
}

fn build_undirected(n: int, edges: array[tuple[int, int]]) -> dict[int, array[int]] {
    graph = {}
    for i in range(n) { graph[i] = [] }
    for e in edges {
        u, v = e[0], e[1]
        graph[u].push(v)
        graph[v].push(u)
    }
    return graph
}

fn __main__() {
    print("=== Cycle Detection ===")

    # Oriented loop 0→1→2→0
    cyclic_d = {0: [1], 1: [2], 2: [0]}
    acyclic_d = {0: [1], 1: [2], 2: []}

    print("Loop oriented: ${has_cycle_directed(cyclic_d)} (expected true)")
    print("Oriented without loop: ${has_cycle_directed(acyclic_d)} (expected false)")

    # Undirected triangle vs tree
    triangle = build_undirected(3, [(0, 1), (1, 2), (2, 0)])
    tree = build_undirected(4, [(0, 1), (1, 2), (2, 3)])

    print("Unoriented triangle: ${has_cycle_undirected(triangle, 3)} (expected true)")
    print("Unorientated tree: ${has_cycle_undirected(tree, 4)} (expected false)")

    # Self-loop in a directed graph
    self_loop = {0: [0]}
    print("Loop: ${has_cycle_directed(self_loop)} (expected true)")
}
