# Levenshtein distance (edit distance)

fn edit_distance(a: str, b: str) -> int {
    """
    Minimum number of insert / delete / replace operations,
    to turn string a into string b.
    """
    m, n = len(a), len(b)
    dp = [[0 for _ in range(n + 1)] for _ in range(m + 1)]

    for i in range(m + 1): dp[i][0] = i
    for j in range(n + 1): dp[0][j] = j

    for i in range(1, m + 1) {
        for j in range(1, n + 1) {
            cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            dp[i][j] = min(
                dp[i - 1][j] + 1, # delete
                dp[i][j - 1] + 1, # insert
                dp[i - 1][j - 1] + cost # replacement (or 0 if the characters match)
            )
        }
    }
    return dp[m][n]
}

fn edit_distance_space_optimized(a: str, b: str) -> int {
    """Two DP rows instead of a full matrix - O(min(n,m)) memory."""
    if len(a) < len(b): return edit_distance_space_optimized(b, a)

    m, n = len(a), len(b)
    prev = [j for j in range(n + 1)]
    curr = [0 for _ in range(n + 1)]

    for i in range(1, m + 1) {
        curr[0] = i
        for j in range(1, n + 1) {
            cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            curr[j] = min(
                prev[j] + 1,
                curr[j - 1] + 1,
                prev[j - 1] + cost
            )
        }
        prev, curr = curr, [0 for _ in range(n + 1)]
    }
    return prev[n]
}

fn edit_distance_with_ops(a: str, b: str) -> list[str] {
    """Restoring the sequence of operations (for demonstration)."""
    m, n = len(a), len(b)
    dp = [[0 for _ in range(n + 1)] for _ in range(m + 1)]

    for i in range(m + 1): dp[i][0] = i
    for j in range(n + 1): dp[0][j] = j

    for i in range(1, m + 1) {
        for j in range(1, n + 1) {
            cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            dp[i][j] = min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost)
        }
    }

    ops = []
    i, j = m, n
    while i > 0 or j > 0 {
        if i > 0 and j > 0 {
            replace_cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            if dp[i][j] == dp[i - 1][j - 1] + replace_cost {
                if a[i - 1] != b[j - 1] {
                    ops.push("replace '${a[i - 1]}' -> '${b[j - 1]}' @ (${i - 1}, ${j - 1})")
                }
                i -= 1
                j -= 1
            } else if dp[i][j] == dp[i][j - 1] + 1 {
                ops.push("insert '${b[j - 1]}' @ ${j - 1}")
                j -= 1
            } else {
                ops.push("delete '${a[i - 1]}' @ ${i - 1}")
                i -= 1
            }
        } else if j > 0 {
            ops.push("insert '${b[j - 1]}' @ ${j - 1}")
            j -= 1
        } else {
            ops.push("delete '${a[i - 1]}' @ ${i - 1}")
            i -= 1
        }
    }
    return reverse(ops)
}

fn __main__() {
    print("=== Edit Distance (Levenshtein) ===")

    pairs = [
        ["kitten", "sitting"],
        ["", "abc"],
        ["abc", ""],
        ["abc", "abc"],
        ["Saturday", "Sunday"],
        ["intention", "execution"],
    ]

    for p in pairs {
        a, b = p[0], p[1]
        dist = edit_distance(a, b)
        opt = edit_distance_space_optimized(a, b)
        print("\"${a}\" -> \"${b}\": dist=${dist}, opt=${opt}")
        if dist != opt: print("  ERROR: versions did not match")

        if len(a) <= 12 and len(b) <= 12 {
            ops = edit_distance_with_ops(a, b)
            print("  operations (${len(ops)}):")
            for op in ops: print("    ${op}")
        }
    }
}
