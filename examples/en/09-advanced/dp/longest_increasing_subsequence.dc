# Longest increasing subsequence (LIS)

fn lis_length_quadratic(nums: list[int]) -> int {
    """
    Classic DP table: dp[i] - length of LIS ending in nums[i].
    O(n²) - visual for learning.
    """
    n = len(nums)
    if n == 0: return 0

    dp = [1 for _ in range(n)]
    best = 1

    for i in range(1, n) {
        for j in range(i) {
            if nums[j] < nums[i] and dp[j] + 1 > dp[i] {
                dp[i] = dp[j] + 1
            }
        }
        if dp[i] > best: best = dp[i]
    }
    return best
}

fn lower_bound(arr: list[int], target: int) -> int {
    """First index where arr[i] >= target (binary search)."""
    lo, hi = 0, len(arr)
    while lo < hi {
        mid = (lo + hi) // 2
        if arr[mid] < target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

fn lis_length_nlogn(nums: list[int]) -> int {
    """
    Algorithm “patience sorting”: tails[k] — minimum LIS tail of length k+1.
    O(n log n).
    """
    tails = []
    for x in nums {
        pos = lower_bound(tails, x)
        if pos == len(tails) {
            tails.push(x)
        } else {
            tails[pos] = x
        }
    }
    return len(tails)
}

fn lis_sequence(nums: list[int]) -> list[int] {
    """Recovery of one LIS (not necessarily the only one)."""
    n = len(nums)
    if n == 0: return []

    dp = [1 for _ in range(n)]
    parent = [-1 for _ in range(n)]

    best_idx = 0
    for i in range(1, n) {
        for j in range(i) {
            if nums[j] < nums[i] and dp[j] + 1 > dp[i] {
                dp[i] = dp[j] + 1
                parent[i] = j
            }
        }
        if dp[i] > dp[best_idx]: best_idx = i
    }

    seq = []
    idx = best_idx
    while idx >= 0 {
        seq.push(nums[idx])
        idx = parent[idx]
    }
    return reverse(seq)
}

fn __main__() {
    print("=== Longest Increasing Subsequence ===")

    cases = [
        [10, 9, 2, 5, 3, 7, 101, 18],
        [0, 1, 0, 3, 2, 3],
        [7, 7, 7, 7],
        [1],
        [],
        [4, 10, 4, 3, 8, 9],
    ]

    for nums in cases {
        q = lis_length_quadratic(nums)
        fast = lis_length_nlogn(nums)
        seq = lis_sequence(nums)
        print("nums=${nums}")
        print("  length: O(n²)=${q}, O(n log n)=${fast}, seq=${seq}")
        if q != fast or q != len(seq) {
            print("  ERROR: inconsistent results")
        }
    }
}
