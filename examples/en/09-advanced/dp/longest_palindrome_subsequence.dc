# Largest palindromic subsequence (LPS) - DP O(n²)

fn lps_length(s: str) -> int {
    n = len(s)
    if n == 0: return 0

    dp = [[0 for _ in range(n)] for _ in range(n)]

    for i in range(n) { dp[i][i] = 1 }

    for length in range(2, n + 1) {
        for i in range(n - length + 1) {
            j = i + length - 1
            if s[i] == s[j] {
                inner = 0 if length == 2 else dp[i + 1][j - 1]
                dp[i][j] = inner + 2
            } else {
                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])
            }
        }
    }
    return dp[0][n - 1]
}

fn lps_string(s: str) -> str {
    """Recovery of one LPS."""
    n = len(s)
    if n == 0: return ""

    dp = [[0 for _ in range(n)] for _ in range(n)]
    for i in range(n) { dp[i][i] = 1 }

    for length in range(2, n + 1) {
        for i in range(n - length + 1) {
            j = i + length - 1
            if s[i] == s[j] {
                inner = 0 if length == 2 else dp[i + 1][j - 1]
                dp[i][j] = inner + 2
            } else {
                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])
            }
        }
    }

    i = 0
    j = n - 1
    left = []
    right = []

    while i <= j {
        if s[i] == s[j] {
            if i == j { left.push(s[i]) }
            else {
                left.push(s[i])
                right.push(s[j])
            }
            i += 1
            j -= 1
        } else if dp[i + 1][j] >= dp[i][j - 1] {
            i += 1
        } else {
            j -= 1
        }
    }
    return join(left, "") + join(reverse(right), "")
}

fn __main__() {
    print("=== Longest Palindrome Subsequence ===")

    tests = [
        ("bbbab", 4),
        ("cbbd", 2),
        ("a", 1),
        ("character", 5),
    ]

    for t in tests {
        s, expected = t[0], t[1]
        got = lps_length(s)
        sub = lps_string(s)
        status = if got == expected { "OK" } else { "FAIL" }
        print("  ${status}: '${s}' → len=${got}, sub='${sub}', expected ${expected}")
    }
}
