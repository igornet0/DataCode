# Error Handling in DataCode
# Demonstrates try/catch/throw/finally blocks

print("============================================================")
print("Error Handling Examples")
print("============================================================")
print()

# Example 1: Basic try/catch
print("🔍 Example 1: Basic try/catch...")
try {
    global result = 10 / 0
    print("  This won't be printed")
} catch e {
    print("  ✓ Caught error:", e)
    global error_handled = true
}
print()

# Example 2: try/catch without error variable
print("🔍 Example 2: try/catch without error variable...")
try {
    global x = 42
    print("  ✓ Code executed successfully: x =", x)
} catch {
    print("  This won't be printed (no error)")
}
print()

# Example 3: try/finally
print("🔍 Example 3: try/finally...")
global cleanup_done = false
try {
    global value = 100
    print("  ✓ Value set:", value)
} finally {
    global cleanup_done = true
    print("  ✓ Finally block executed (cleanup done =", cleanup_done, ")")
}
print()

# Example 4: try/catch/finally
print("🔍 Example 4: try/catch/finally...")
global error_caught = false
global cleanup_completed = false
try {
    throw "Test exception"
    print("  This won't be printed")
} catch e {
    global error_caught = true
    print("  ✓ Exception caught:", e)
} finally {
    global cleanup_completed = true
    print("  ✓ Finally block always runs (cleanup =", cleanup_completed, ")")
}
print()

# Example 5: Using throw to create exceptions
print("🔍 Example 5: Using throw to create exceptions...")
fn validate_age(age) {
    if age < 0 {
        throw "Age cannot be negative"
    }
    if age > 150 {
        throw "Age seems unrealistic"
    }
    return true
}

try {
    validate_age(-5)
} catch e {
    print("  ✓ Validation error caught:", e)
}

try {
    validate_age(200)
} catch e {
    print("  ✓ Validation error caught:", e)
}

try {
    validate_age(25)
    print("  ✓ Age validation passed for 25")
} catch e {
    print("  This won't be printed")
}
print()

# Example 6: Nested try/catch blocks
print("🔍 Example 6: Nested try/catch blocks...")
try {
    global outer_step = "step1"
    print("  ✓ Outer try: step1")
    
    try {
        global inner_step = "step2"
        print("  ✓ Inner try: step2")
        throw "Inner exception"
    } catch e {
        print("  ✓ Inner catch: handled", e)
        global inner_handled = true
    }
    
    global outer_step = "step3"
    print("  ✓ Outer try: step3")
} catch e {
    print("  ✓ Outer catch: handled", e)
}
print()

# Example 7: Error handling in functions
print("🔍 Example 7: Error handling in functions...")
fn safe_divide(a, b) {
    if b == 0 {
        throw "Division by zero is not allowed"
    }
    return a / b
}

fn calculate_with_error_handling(a, b) {
    try {
        let result = safe_divide(a, b)
        return result
    } catch e {
        print("  ⚠️  Calculation error:", e)
        return null
    }
}

global result1 = calculate_with_error_handling(10, 2)
print("  ✓ 10 / 2 =", result1)

global result2 = calculate_with_error_handling(10, 0)
print("  ✓ 10 / 0 handled safely, result =", result2)
print()

# Example 8: File operations with error handling
print("🔍 Example 8: File operations with error handling...")
fn safe_read(file_path) {
    try {
        let data = read(file_path)
        return data
    } catch e {
        print("  ⚠️  Could not read file:", file_path, "-", e)
        return null
    }
}

global test_file = path("nonexistent_file.txt")
global file_data = safe_read(test_file)
if file_data == null {
    print("  ✓ File read error handled correctly")
}
print()

# Example 9: Multiple operations with error handling
print("🔍 Example 9: Multiple operations with error handling...")
fn process_data(data) {
    try {
        if data == null {
            throw "Data is null"
        }
        if len(data) == 0 {
            throw "Data is empty"
        }
        return "Processing successful"
    } catch e {
        return "Error: " + e
    }
}

global result3 = process_data([1, 2, 3])
print("  ✓", result3)

global result4 = process_data(null)
print("  ✓", result4)

global result5 = process_data([])
print("  ✓", result5)
print()

# Example 10: Error propagation
print("🔍 Example 10: Error propagation...")
fn level1() {
    throw "Error from level 1"
}

fn level2() {
    level1()
}

try {
    level2()
} catch e {
    print("  ✓ Error propagated and caught:", e)
}
print()

print("============================================================")
print("✅ Error handling examples completed")
print("============================================================")
