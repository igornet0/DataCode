# HTTP DataSource example (requires network)

api = datasource({ type: "http", url: "https://httpbin.org", timeout: 30 })

resp = api.request({
    method: "GET",
    path: "/get",
    query: { foo: "bar" }
})

print("status:", resp.status)
print("success:", resp.success)
data = resp.json()
print(typeof(data))

users = api.get_table({ path: "/get" })
print("rows:", len(users))
