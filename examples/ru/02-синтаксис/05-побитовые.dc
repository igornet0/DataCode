# Побитовые операторы (&, |, ^, ~, <<, >>) — только целые операнды

print("=== Побитовые операторы ===")
print("5 & 3 =", 5 & 3)
print("5 | 3 =", 5 | 3)
print("5 ^ 3 =", 5 ^ 3)
print("~5 =", ~5)
print("1 << 5 =", 1 << 5)
print("32 >> 2 =", 32 >> 2)
print("1 << 2 + 1 =", 1 << 2 + 1)

# Битовые маски
mask = 0
i = 3
mask = mask | (1 << i)
print("mask после установки бита ${i}:", mask)

if mask & (1 << i) {
    print("бит ${i} установлен")
}

mask = mask & ~(1 << i)
print("mask после сброса бита ${i}:", mask)

mask = mask ^ (1 << i)
print("mask после переключения бита ${i}:", mask)
