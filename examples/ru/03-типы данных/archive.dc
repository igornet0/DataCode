zip_path = path("tests/test_data/archives/sample.zip")
zip = archive(zip_path)
print(zip.format)
print(zip.count)
print(zip.size)
print(zip.compressed_size)
for file in zip.files {
    print(file.path)
}
data = zip.read("config/settings.json")
print(typeof(data))
text = zip.read_text("README.md")
print(contains(text, "Hello Archive"))
table = zip.read("data/sample.csv")
print(typeof(table))
out = path("tests/test_data/archives/out")
zip.extract(out)
zip.close()
print(path_exists(out / path("config/settings.json")))
