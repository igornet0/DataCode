# enum(iterable) и конструктор Table(path)

print("=== enum — индекс + элемент ===")
items = ["a", "b", "c"]
for i, x in enum(items) {
    print("enum:", i, x)
}

print("\n=== Table(path) — загрузка CSV ===")
t = Table(path("таблицы/01-трансформация/data/employees.csv"))
print("rows:", len(t))
show_table(table_head(t, 3))
print("typeof(Table(...)):", typeof(t))
print("isinstance(t, Table):", isinstance(t, Table))
