# Трансформация: группа «Пустые значения»
# CSV: data/employees.csv (пустые ячейки → null)
# Дополнительно: таблица с явными null через table()
#
# Операции UI: fillEmpty, dropEmptyRows

employees = read(path("data/employees.csv"))

print("=== fillEmpty — заменить пустые ===")
# Пустая ячейка CSV и null в table() считаются null.
print("City[5] (пусто):", employees["City"][5])

fn fill_empty(v, default) {
    if v == null {
        return default
    }
    if v == "" {
        return default
    }
    return v
}

# Встроенный table_map применяет функцию к каждой ячейке указанной колонки.
filled = table_map(employees, "City", fn(x) => fill_empty(x, "Unknown"))
print("после fill:", filled["City"][5])

print("\n=== replaceNulls — заменить null значениями ===")
replaced_city = table_replace_nulls(employees, "City", "Unknown")
print("replace City:", replaced_city["City"][5])

# Без указания column — замена null во всех колонках
replaced_any = employees.replace_nulls("Unknown")
print("replace any null (строк):", len(replaced_any))

# Callback получает объект строки
replaced_by_fn = table_replace_nulls(
    employees,
    ["City", "Notes"],
    fn(row) => if row["Amount"] < 1000 { null } else { "Unknown" }
)
print("callback replace City[5]:", replaced_by_fn["City"][5])

print("\n=== dropEmptyRows — удалить строки с пустым ===")
# table_drop_nulls(table [, column])
# Без column — удалить строку, если null в любой колонке.
# С column — если null в указанной колонке (или в любой из списка).

print("строк до:", len(employees))
no_null_notes = table_drop_nulls(employees, "Notes")
print("без null в Notes:", len(no_null_notes))

no_null_city = table_drop_nulls(employees, "City")
print("без null в City:", len(no_null_city))

# Метод на объекте таблицы:
no_null_any = employees.drop_nulls()
print("без null в любой колонке:", len(no_null_any))

# Явные null в литерале table():
raw = table([
    [1, "Alice", 28],
    [2, null, 35],
    [3, "Charlie", null],
], ["id", "name", "age"])
clean = table_drop_nulls(raw, ["name", "age"])
print("table() + drop_nulls по [name, age]:", len(clean), "строк")

print("\nDone.")
