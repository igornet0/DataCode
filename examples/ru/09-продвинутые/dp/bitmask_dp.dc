# DP по битовым маскам — задача коммивояжёра (TSP) для малых n

INF = float(inf)

fn tsp(dist: list[list[float]]) -> float {
    """
    Минимальный цикл, проходящий все вершины ровно один раз (старт в 0).
    dist[i][j] — вес ребра i→j; INF если ребра нет.
    """
    n = len(dist)
    if n == 0: return 0.0

    size = 1 << n
    dp = [[INF for _ in range(n)] for _ in range(size)]
    dp[1][0] = 0.0

    for mask in range(size) {
        for u in range(n) {
            if dp[mask][u] == INF: continue
            if (mask & (1 << u)) == 0: continue

            for v in range(n) {
                if (mask & (1 << v)) != 0: continue
                nmask = mask | (1 << v)
                nd = dp[mask][u] + dist[u][v]
                if nd < dp[nmask][v] { dp[nmask][v] = nd }
            }
        }
    }

    full = size - 1
    best = INF
    for u in range(1, n) {
        if dp[full][u] + dist[u][0] < best {
            best = dp[full][u] + dist[u][0]
        }
    }
    return best
}

fn __main__() {
    print("=== Bitmask DP (TSP) ===")

    INF_LOCAL = 1000000.0
    dist = [
        [0.0, 10.0, 15.0, 20.0],
        [10.0, 0.0, 35.0, 25.0],
        [15.0, 35.0, 0.0, 30.0],
        [20.0, 25.0, 30.0, 0.0],
    ]

    best = tsp(dist)
    print("матрица 4×4, мин. тур: ${best} (ожид. 80.0)")

    status = if best == 80.0 { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
