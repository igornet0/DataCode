# Наибольшая общая подпоследовательность (LCS)

fn lcs_length(a: str, b: str) -> int {
    """Длина LCS двух строк. O(n·m) по времени, O(n·m) по памяти."""
    m, n = len(a), len(b)
    dp = [[0 for _ in range(n + 1)] for _ in range(m + 1)]

    for i in range(1, m + 1) {
        for j in range(1, n + 1) {
            if a[i - 1] == b[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])
            }
        }
    }
    return dp[m][n]
}

fn lcs_string(a: str, b: str) -> str {
    """Восстановление одной LCS-строки по заполненной таблице."""
    m, n = len(a), len(b)
    dp = [[0 for _ in range(n + 1)] for _ in range(m + 1)]

    for i in range(1, m + 1) {
        for j in range(1, n + 1) {
            if a[i - 1] == b[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])
            }
        }
    }

    # Обратный проход по таблице
    i, j = m, n
    chars = []
    while i > 0 and j > 0 {
        if a[i - 1] == b[j - 1] {
            chars.push(a[i - 1])
            i -= 1
            j -= 1
        } else if dp[i - 1][j] >= dp[i][j - 1] {
            i -= 1
        } else {
            j -= 1
        }
    }
    return join(reverse(chars), "")
}

fn lcs_length_space_optimized(a: str, b: str) -> int {
    """Только две строки DP — O(min(n,m)) памяти."""
    if len(a) < len(b): return lcs_length_space_optimized(b, a)

    m, n = len(a), len(b)
    prev = [0 for _ in range(n + 1)]
    curr = [0 for _ in range(n + 1)]

    for i in range(1, m + 1) {
        for j in range(1, n + 1) {
            if a[i - 1] == b[j - 1] {
                curr[j] = prev[j - 1] + 1
            } else {
                curr[j] = max(prev[j], curr[j - 1])
            }
        }
        prev, curr = curr, [0 for _ in range(n + 1)]
    }
    return prev[n]
}

fn __main__() {
    print("=== Longest Common Subsequence ===")

    pairs = [
        ["ABCBDAB", "BDCABA"],
        ["AGGTAB", "GXTXAYB"],
        ["abc", "def"],
        ["", "abc"],
        ["programming", "gaming"],
    ]

    for p in pairs {
        a, b = p[0], p[1]
        length = lcs_length(a, b)
        seq = lcs_string(a, b)
        opt = lcs_length_space_optimized(a, b)
        print("\"${a}\" × \"${b}\"")
        print("  длина LCS: ${length}, строка: \"${seq}\", opt=${opt}")
        if length != len(seq) or length != opt {
            print("  ОШИБКА: несогласованные результаты")
        }
    }
}
