# Динамическое программирование на дереве — независимое множество

fn build_tree_adj(n: int, edges: list[tuple[int, int]]) -> dict[int, list[int]] {
    adj = {}
    for i in range(n) { adj[i] = [] }
    for e in edges {
        adj[e[0]].push(e[1])
        adj[e[1]].push(e[0])
    }
    return adj
}

fn tree_independent_set_max_weight(
    adj: dict[int, list[int]],
    root: int,
    weights: list[int]) -> int {

    """
    Максимальный вес независимого множества на дереве.
    dp0[v] — лучший вес поддерева v, если v НЕ берём.
    dp1[v] — если v берём.
    """

    fn dfs(v: int, parent: int) -> tuple[int, int] {
        take = weights[v]
        skip = 0

        for u in adj[v] {
            if u == parent: continue
            child_take, child_skip = dfs(u, v)
            take += child_skip
            skip += max(child_take, child_skip)
        }
        return (take, skip)
    }

    res = dfs(root, -1)
    return max(res[0], res[1])
}

fn tree_diameter(adj: dict[int, list[int]], root: int) -> int {
    """Диаметр дерева — два BFS/DFS от дальних точек."""

    fn farthest(start: int) -> tuple[int, int] {
        dist = {}
        queue = [start]
        dist[start] = 0
        far_node = start
        far_dist = 0

        while len(queue) > 0 {
            v = queue.pop(0)
            for u in adj[v] {
                if u in dist: continue
                dist[u] = dist[v] + 1
                if dist[u] > far_dist {
                    far_dist = dist[u]
                    far_node = u
                }
                queue.push(u)
            }
        }
        return (far_node, far_dist)
    }

    a, _ = farthest(root)
    _, d = farthest(a)
    return d
}

fn __main__() {
    print("=== Tree DP ===")

    #       0
    #      / \
    #     1   2
    #    / \
    #   3   4
    n = 5
    edges = [(0, 1), (0, 2), (1, 3), (1, 4)]
    adj = build_tree_adj(n, edges)
    weights = [10, 5, 8, 4, 6]

    best = tree_independent_set_max_weight(adj, 0, weights)
    diam = tree_diameter(adj, 0)

    print("веса: ${weights}")
    print("макс. независимое множество: ${best} (ожид. 20 = 10+4+6)")
    print("диаметр: ${diam} (ожид. 3)")

    status = if best == 20 and diam == 3 { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
