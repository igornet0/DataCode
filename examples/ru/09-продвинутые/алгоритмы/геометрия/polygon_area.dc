# Площадь многоугольника — формула шнуровки (Shoelace)

fn polygon_area(points: list[tuple[float, float]]) -> float {
    """
    Вершины по порядку (по или против часовой стрелки).
    |area| = 0.5 * |Σ (x_i * y_{i+1} - x_{i+1} * y_i)|.
    """
    n = len(points)
    if n < 3: return 0.0

    sum_val = 0.0
    for i in range(n) {
        x1, y1 = points[i][0], points[i][1]
        x2, y2 = points[(i + 1) % n][0], points[(i + 1) % n][1]
        sum_val += x1 * y2 - x2 * y1
    }
    return abs(sum_val) / 2.0
}

fn polygon_perimeter(points: list[tuple[float, float]]) -> float {
    n = len(points)
    if n < 2: return 0.0
    total = 0.0
    for i in range(n) {
        x1, y1 = points[i][0], points[i][1]
        x2, y2 = points[(i + 1) % n][0], points[(i + 1) % n][1]
        dx = x2 - x1
        dy = y2 - y1
        total += (dx * dx + dy * dy) ** 0.5
    }
    return total
}

fn __main__() {
    print("=== Polygon Area (Shoelace) ===")

    square = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0)]
    triangle = [(0.0, 0.0), (4.0, 0.0), (0.0, 3.0)]

    a1 = polygon_area(square)
    a2 = polygon_area(triangle)

    print("квадрат 2×2: площадь=${a1}, периметр=${polygon_perimeter(square)}")
    print("треугольник 3-4-5: площадь=${a2}")

    status = if a1 == 4.0 and a2 == 6.0 { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
