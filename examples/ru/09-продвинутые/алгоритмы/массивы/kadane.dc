# Алгоритм Кадане — максимальная сумма подмассива за O(n)

fn max_subarray_sum(arr: list[int]) -> int {
    """Максимальная сумма непустого непрерывного подмассива."""
    if len(arr) == 0: throw "массив не должен быть пустым"

    best = arr[0]
    current = arr[0]

    for i in range(1, len(arr)) {
        x = arr[i]
        current = max(x, current + x)
        best = max(best, current)
    }
    return best
}

fn max_subarray_slice(arr: list[int]) -> tuple[int, int, int] {
    """Возвращает (max_sum, start_index, end_index) для одного оптимального отрезка."""
    if len(arr) == 0: throw "массив не должен быть пустым"

    best = arr[0]
    current = arr[0]
    start = 0
    end = 0
    temp_start = 0

    for i in range(1, len(arr)) {
        x = arr[i]
        if current + x < x {
            current = x
            temp_start = i
        } else {
            current = current + x
        }
        if current > best {
            best = current
            start = temp_start
            end = i
        }
    }
    return (best, start, end)
}

fn __main__() {
    print("=== Kadane (max subarray sum) ===")

    tests = [
        ([-2, 1, -3, 4, -1, 2, 1, -5, 4], 6),
        ([1], 1),
        ([5, 4, -1, 7, 8], 23),
        ([-1, -2, -3], -1),
    ]

    for t in tests {
        arr, expected = t[0], t[1]
        got = max_subarray_sum(arr)
        status = if got == expected { "OK" } else { "FAIL" }
        print("  ${status}: ${arr} → ${got}, ожид. ${expected}")
    }

    slice = max_subarray_slice([-2, 1, -3, 4, -1, 2, 1, -5, 4])
    print("Лучший отрезок: sum=${slice[0]}, [${slice[1]}..${slice[2]}]")
}
