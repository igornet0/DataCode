# Префиксные суммы — O(n) предобработка, O(1) запрос суммы на отрезке

fn build_prefix(arr: list[int]) -> list[int] {
    """
    prefix[i] = sum(arr[0..i-1]), prefix[0] = 0.
    Сумма arr[l..r] включительно = prefix[r+1] - prefix[l].
    """
    prefix = [0]
    for x in arr { prefix.push(prefix[-1] + x) }
    return prefix
}

fn range_sum(prefix: list[int], left: int, right: int) -> int {
    """Сумма arr[left..right] по префиксному массиву (0-based, включительно)."""
    return prefix[right + 1] - prefix[left]
}

fn count_in_range(prefix: list[int], value: int, left: int, right: int) -> int {
    """Сколько раз value встречается на отрезке — через разность префиксов частот."""
    return range_sum(prefix, left, right)
}

fn __main__() {
    print("=== Prefix Sum ===")

    arr = [1, 2, 3, 4, 5]
    pref = build_prefix(arr)
    print("массив: ${arr}")
    print("prefix: ${pref}")

    queries = [(0, 2, 6), (1, 3, 9), (0, 4, 15)]
    for q in queries {
        l, r, expected = q[0], q[1], q[2]
        got = range_sum(pref, l, r)
        status = if got == expected { "OK" } else { "FAIL" }
        print("  ${status}: sum[${l}..${r}] = ${got}, ожид. ${expected}")
    }
}
