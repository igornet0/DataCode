# Максимум в скользящем окне — монотонная дека, O(n)

fn sliding_window_maximum(nums: list[int], k: int) -> list[int] {
    """
    Для каждого окна размера k вернуть максимум.
    deque хранит индексы в порядке убывания nums[index].
    """
    if k <= 0 or len(nums) == 0: return []
    if k == 1: return nums

    deque = []
    result = []

    for i in range(len(nums)) {
        # Удалить индексы вне окна
        while len(deque) > 0 and deque[0] <= i - k {
            deque.pop(0)
        }
        # Поддерживать убывающую последовательность значений
        while len(deque) > 0 and nums[deque[-1]] <= nums[i] {
            deque.pop()
        }
        deque.push(i)

        if i >= k - 1 {
            result.push(nums[deque[0]])
        }
    }
    return result
}

fn __main__() {
    print("=== Sliding Window Maximum ===")

    nums = [1, 3, -1, -3, 5, 3, 6, 7]
    k = 3
    got = sliding_window_maximum(nums, k)
    expected = [3, 3, 5, 5, 6, 7]

    print("nums: ${nums}")
    print("k=${k} → ${got}")
    status = if got == expected { "OK" } else { "FAIL" }
    print("Тест: ${status} (ожид. ${expected})")
}
