# Бинарный поиск — O(log n), массив должен быть отсортирован

fn binary_search(arr: list[int], target: int) -> int {
    """
    Итеративный бинарный поиск.
    Возвращает индекс target или -1.
    """
    lo = 0
    hi = len(arr) - 1

    while lo <= hi {
        mid = lo + (hi - lo) // 2
        if arr[mid] == target: return mid
        if arr[mid] < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

fn binary_search_recursive(arr: list[int], target: int, lo: int, hi: int) -> int {
    """Рекурсивный вариант."""
    if lo > hi: return -1
    mid = lo + (hi - lo) // 2
    
    if arr[mid] == target: return mid
    if arr[mid] < target: return binary_search_recursive(arr, target, mid + 1, hi)
    
    return binary_search_recursive(arr, target, lo, mid - 1)
}

fn __main__() {
    print("=== Binary Search ===")

    data = [1, 3, 5, 7, 9, 11, 13, 15, 17]
    tests = [
        (1, 0),
        (7, 3),
        (17, 8),
        (4, -1),
        (18, -1),
    ]

    print("Массив: ${data}")
    for t in tests {
        target, expected = t[0], t[1]
        got = binary_search(data, target)
        got_rec = binary_search_recursive(data, target, 0, len(data) - 1)
        status = if got == expected and got_rec == expected { "OK" } else { "FAIL" }
        print("  ${status}: search(${target}) = ${got}, rec = ${got_rec}, ожид. ${expected}")
    }
}
