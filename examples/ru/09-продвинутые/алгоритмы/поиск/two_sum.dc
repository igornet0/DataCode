# Two Sum — найти два индекса с суммой target (O(n) через хеш-таблицу)

fn two_sum(nums: list[int], target: int) -> Optional[tuple[int, int]] {
    """
    Возвращает пару индексов (i, j), i < j, или null.
    """
    seen = {}
    for i in range(len(nums)) {
        need = target - nums[i]
        if need in seen {
            return (seen[need], i)
        }
        seen[nums[i]] = i
    }
    return null
}

fn two_sum_values(nums: list[int], target: int) -> Optional[tuple[int, int]] {
    """Возвращает пару значений (не индексов)."""
    pair = two_sum(nums, target)
    if pair == null: return null
    return (nums[pair[0]], nums[pair[1]])
}

fn __main__() {
    print("=== Two Sum ===")

    tests = [
        ([2, 7, 11, 15], 9, (0, 1)),
        ([3, 2, 4], 6, (1, 2)),
        ([3, 3], 6, (0, 1)),
        ([1, 2, 3], 10, null),
    ]

    for t in tests {
        nums, target, expected = t[0], t[1], t[2]
        got = two_sum(nums, target)
        status = if got == expected { "OK" } else { "FAIL" }
        print("  ${status}: two_sum(${nums}, ${target}) = ${got}, ожид. ${expected}")
    }

    vals = two_sum_values([2, 7, 11, 15], 9)
    print("\nЗначения для суммы 9: ${vals} (ожид. (2, 7))")
}
