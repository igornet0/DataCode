# Сортировка пузырьком — O(n²), стабильная

fn bubble_sort(arr: list[int]) -> list[int] {
    """Сортировка по возрастанию, возвращает новый массив."""
    a = copy(arr)
    n = len(a)

    for i in range(n) {
        swapped = false
        for j in range(n - 1 - i) {
            if a[j] > a[j + 1] {
                a[j], a[j + 1] = a[j + 1], a[j]
                swapped = true
            }
        }
        if !swapped: break
    }
    return a
}

fn is_sorted(arr: list[int]) -> bool {
    for i in range(len(arr) - 1) {
        if arr[i] > arr[i + 1]: return false
    }
    return true
}

fn __main__() {
    print("=== Bubble Sort ===")

    tests = [
        [5, 1, 4, 2, 8],
        [1],
        [],
        [3, 3, 3],
        [9, 8, 7, 6, 5],
    ]

    for data in tests {
        sorted_arr = bubble_sort(data)
        ok = is_sorted(sorted_arr)
        same_len = len(sorted_arr) == len(data)
        print("  ${data} → ${sorted_arr}  sorted=${ok and same_len}")
    }
}
