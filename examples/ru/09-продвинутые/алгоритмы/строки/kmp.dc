# Алгоритм Кнута-Морриса-Пратта (KMP) — поиск подстроки за O(n+m)

fn build_lps(pattern: str) -> list[int] {
    """Таблица префикс-функции (longest proper prefix which is suffix)."""
    m = len(pattern)
    lps = [0 for _ in range(m)]
    length = 0
    i = 1

    while i < m {
        if pattern[i] == pattern[length] {
            length += 1
            lps[i] = length
            i += 1
        } else if length > 0 {
            length = lps[length - 1]
        } else {
            lps[i] = 0
            i += 1
        }
    }
    return lps
}

fn kmp_search(text: str, pattern: str) -> list[int] {
    """Все позиции вхождения pattern в text (0-based)."""
    n = len(text)
    m = len(pattern)
    if m == 0: return []

    lps = build_lps(pattern)
    result = []
    i = 0
    j = 0

    while i < n {
        if text[i] == pattern[j] {
            i += 1
            j += 1
            if j == m {
                result.push(i - j)
                j = lps[j - 1]
            }
        } else if j > 0 {
            j = lps[j - 1]
        } else {
            i += 1
        }
    }
    return result
}

fn __main__() {
    print("=== KMP String Search ===")

    text = "ababcababcabc"
    pattern = "abc"
    positions = kmp_search(text, pattern)

    print("text: '${text}'")
    print("pattern: '${pattern}'")
    print("позиции: ${positions} (ожид. [2, 7, 10])")

    status = if positions == [2, 7, 10] { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
