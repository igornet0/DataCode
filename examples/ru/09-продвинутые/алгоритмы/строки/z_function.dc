# Z-функция — префиксные совпадения за O(n)

fn z_function(s: str) -> list[int] {
    """
    z[i] — длина наибольшего общего префикса s и s[i..].
    z[0] = 0 по определению в этой реализации.
    """
    n = len(s)
    if n == 0: return []

    z = [0 for _ in range(n)]
    l = 0
    r = 0

    for i in range(1, n) {
        if i <= r { z[i] = min(r - i + 1, z[i - l]) }
        while i + z[i] < n and s[z[i]] == s[i + z[i]] {
            z[i] += 1
        }
        if i + z[i] - 1 > r {
            l = i
            r = i + z[i] - 1
        }
    }
    return z
}

fn z_search(text: str, pattern: str) -> list[int] {
    """Поиск pattern в text через Z на pattern + '$' + text."""
    if len(pattern) == 0: return []
    combined = pattern + "$" + text
    z = z_function(combined)
    m = len(pattern)
    result = []

    for i in range(m + 1, len(combined)) {
        if z[i] == m { result.push(i - m - 1) }
    }
    return result
}

fn __main__() {
    print("=== Z-Function ===")

    s = "aabcaabxaaz"
    z = z_function(s)
    print("s='${s}'")
    print("z=${z}")

    text = "ababcababcabc"
    positions = z_search(text, "abc")
    print("поиск 'abc': ${positions} (ожид. [2, 7, 10])")

    status = if positions == [2, 7, 10] { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
