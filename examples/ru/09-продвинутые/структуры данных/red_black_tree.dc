# Красно-чёрное дерево — упрощённая вставка с балансировкой

RED = 0
BLACK = 1

cls RbNode {
    public:
        value: int
        color: int
        left: Optional[RbNode]
        right: Optional[RbNode]
        parent: Optional[RbNode]

    new RbNode(value: int, color: int = RED) {
        this.value = value
        this.color = color
        this.left = null
        this.right = null
        this.parent = null
    }
}

cls RedBlackTree {
    private:
        root: Optional[RbNode]
        nil: RbNode

    new RedBlackTree() {
        this.nil = RbNode(0, BLACK)
        this.root = this.nil
    }

    private:
    fn _left_rotate(x: RbNode) {
        y = x.right
        x.right = y.left
        if y.left != this.nil { y.left.parent = x }
        y.parent = x.parent
        if x.parent == this.nil { this.root = y } else if x == x.parent.left { x.parent.left = y } else { x.parent.right = y }
        y.left = x
        x.parent = y
    }

    fn _right_rotate(x: RbNode) {
        y = x.left
        x.left = y.right
        if y.right != this.nil { y.right.parent = x }
        y.parent = x.parent
        if x.parent == this.nil { this.root = y } else if x == x.parent.right { x.parent.right = y } else { x.parent.left = y }
        y.right = x
        x.parent = y
    }

    fn _insert_fixup(k: RbNode) {
        while k.parent.color == RED {
            if k.parent == k.parent.parent.right {
                y = k.parent.parent.left
                if y.color == RED {
                    y.color = BLACK
                    k.parent.color = BLACK
                    k.parent.parent.color = RED
                    k = k.parent.parent
                } else {
                    if k == k.parent.left {
                        k = k.parent
                        this._right_rotate(k)
                    }
                    k.parent.color = BLACK
                    k.parent.parent.color = RED
                    this._left_rotate(k.parent.parent)
                }
            } else {
                y = k.parent.parent.right
                if y.color == RED {
                    y.color = BLACK
                    k.parent.color = BLACK
                    k.parent.parent.color = RED
                    k = k.parent.parent
                } else {
                    if k == k.parent.right {
                        k = k.parent
                        this._left_rotate(k)
                    }
                    k.parent.color = BLACK
                    k.parent.parent.color = RED
                    this._right_rotate(k.parent.parent)
                }
            }
            if k == this.root: break
        }
        this.root.color = BLACK
    }

    public:
    fn insert(value: int) {
        node = RbNode(value)
        node.left = this.nil
        node.right = this.nil
        node.parent = this.nil

        y = this.nil
        x = this.root
        while x != this.nil {
            y = x
            if node.value < x.value { x = x.left } else { x = x.right }
        }
        node.parent = y
        if y == this.nil { this.root = node } else if node.value < y.value { y.left = node } else { y.right = node }

        if node.parent == this.nil {
            node.color = BLACK
            this.root = node
            return
        }
        if node.parent.parent == this.nil: return
        this._insert_fixup(node)
    }

    fn inorder() -> list[int] {
        result = []
        this._inorder(this.root, result)
        return result
    }

    fn _inorder(node: RbNode, result: list[int]) {
        if node == this.nil: return
        this._inorder(node.left, result)
        result.push(node.value)
        this._inorder(node.right, result)
    }
}

fn __main__() {
    print("=== Red-Black Tree ===")

    tree = RedBlackTree()
    for x in [7, 3, 18, 10, 22, 8, 11, 26] { tree.insert(x) }

    vals = tree.inorder()
    print("inorder: ${vals}")

    status = if vals == sort([7, 3, 18, 10, 22, 8, 11, 26]) { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
