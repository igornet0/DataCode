import heapq
from system import time
import system

fn a_star_grid_optimized(
    rows: int,
    cols: int,
    start: tuple[int, int],
    goal: tuple[int, int],
    blocked_ids: set[int],
    g_score,
    f_score,
    came_from,
    closed_set,
    open_heap,
    open_set) -> Optional[list[tuple[int, int]]] {

    diag = system.env.get("DC_ASTAR_DIAG") != null
    diag_every = 200000
    v = system.env.get("DC_ASTAR_DIAG_EVERY")
    if v != null {
        diag_every = int(v)
    }
    if diag {
        print("A*: DIAG enabled every=${diag_every}")
    }

    g_score.clear()
    f_score.clear()
    came_from.clear()
    closed_set.clear()
    open_set.clear()
    heapq.heap_clear(open_heap)

    start_id = start[0] * cols + start[1]
    goal_id = goal[0] * cols + goal[1]
    goal_r, goal_c = goal

    if start_id in blocked_ids or goal_id in blocked_ids: return null

    pops = 0
    pushes = 0
    expansions = 0
    neighbor_checks = 0
    skip_stale = 0
    skip_closed = 0
    t0 = time.perf_counter()

    g_score[start_id] = 0
    f_score[start_id] = abs(start[0] - goal_r) + abs(start[1] - goal_c)

    heapq.heappush(open_heap, (f_score[start_id], start_id))
    pushes += 1
    open_set.add(start_id)

    neighbors_delta = ((-1, 0), (1, 0), (0, -1), (0, 1))

    while open_heap {
        current_f, current = heapq.heappop(open_heap)
        pops += 1

        if diag and pops % diag_every == 0 {
            t = time.perf_counter() - t0
            print("A*: t=${t:.3f}s pops=${pops} pushes=${pushes} exp=${expansions} neigh=${neighbor_checks} stale=${skip_stale} closed=${skip_closed} open_heap=${len(open_heap)} g=${len(g_score)} f=${len(f_score)} came=${len(came_from)} closed=${len(closed_set)}")
        }

        if current_f != f_score.get(current) { skip_stale += 1; continue }

        open_set.discard(current)

        if current in closed_set { skip_closed += 1; continue }

        if current == goal_id {
            t_search = time.perf_counter() - t0
            t_path0 = time.perf_counter()
            path = []
            while current in came_from {
                r, c = divmod(current, cols)
                path.push((r, c))
                current = came_from[current]
            }
            r, c = divmod(current, cols)
            path.push((r, c))
            t_path = time.perf_counter() - t_path0
            if diag {
                print("A*: DONE search=${t_search:.3f}s path=${t_path:.3f}s pops=${pops} pushes=${pushes} exp=${expansions} neigh=${neighbor_checks} stale=${skip_stale} closed=${skip_closed} path_len=${len(path)}")
            }
            return path[::-1]
        }

        closed_set.add(current)
        expansions += 1

        r, c = divmod(current, cols)

        for dr, dc in neighbors_delta {
            neighbor_checks += 1
            nr, nc = r + dr, c + dc
            if !(0 <= nr < rows and 0 <= nc < cols): continue

            neighbor = nr * cols + nc
            if neighbor in blocked_ids or neighbor in closed_set: continue

            tentative_g = g_score[current] + 1

            if tentative_g < g_score.get(neighbor, float(inf)) {
                came_from[neighbor] = current
                g_score[neighbor] = tentative_g
                h = abs(nr - goal_r) + abs(nc - goal_c)
                f = tentative_g + h
                f_score[neighbor] = f

                if !neighbor in open_set {
                    heapq.heappush(open_heap, (f, neighbor))
                    pushes += 1
                    open_set.add(neighbor)
                }
            }
        }
    }

    if diag {
        t = time.perf_counter() - t0
        print("A*: FAIL t=${t:.3f}s pops=${pops} pushes=${pushes} exp=${expansions} neigh=${neighbor_checks} stale=${skip_stale} closed=${skip_closed}")
    }
    return null
}

fn a_star_once(rows: int, cols: int, start: tuple[int, int], goal: tuple[int, int], blocked_ids: set[int]) {
    return a_star_grid_optimized(
        rows, cols, start, goal, blocked_ids,
        {}, {}, {}, set(), [], set())
}

fn stress_test(num_runs: int = 100) {
    rows, cols = 100, 500

    random_seed(42)

    blocked_cells = set()
    for _ in range(1000): blocked_cells.add((random_int(0, rows - 1), random_int(0, cols - 1)))

    start = (0, 0)
    goal = (559, 1234)
    blocked_cells.discard(start)
    blocked_cells.discard(goal)

    blocked_ids = {r * cols + c for r, c in blocked_cells}

    g_score = {}
    f_score = {}
    came_from = {}
    closed_set = set()
    open_heap = []
    open_set = set()

    total_time = 0.0
    success_count = 0
    times = []

    for i in range(num_runs) {
        start_time = time.perf_counter()
        path = a_star_grid_optimized(
            rows, cols, start, goal, blocked_ids,
            g_score, f_score, came_from, closed_set, open_heap, open_set)
        elapsed = time.perf_counter() - start_time
        total_time += elapsed
        times.push(elapsed)
        if path != null: success_count += 1
        if (i + 1) % 10 == 0: print("Прогон ${i+1}/${num_runs} завершён. Текущее среднее: ${total_time/(i+1):.4f} сек.")
    }
    print("\n====== РЕЗУЛЬТАТЫ СТРЕСС-ТЕСТА ======")
    print("Заблокировано клеток:   ${len(blocked_cells)}")
    print("Всего запусков:          ${num_runs}")
    print("Успешных поисков пути:   ${success_count} (${(success_count/num_runs)*100:.1f}%)")
    print("Общее время:             ${total_time:.2f} сек.")
    print("Среднее время на поиск:  ${total_time/num_runs:.4f} сек.")
    sorted_times = sort(times)
    n = len(sorted_times)
    if n % 2 == 1 {
        median = sorted_times[n // 2]
    } else {
        median = (sorted_times[n // 2 - 1] + sorted_times[n // 2]) / 2.0
    }
    print("Медианное время:         ${median:.4f} сек.")
}

fn __main__() {
    print("Тестовый единичный запуск...")
    rows, cols = 100, 500
    blocked = set()
    start = (0, 0)
    goal = (50, 234)
    blocked_ids = {r * cols + c for r, c in blocked}
    path = a_star_once(rows, cols, start, goal, blocked_ids)

    if path {
        print(f"Путь найден, длина = {len(path)}")
    } else {
        print("Путь не найден")
    }

    runs = 10
    v = system.env.get("DC_ASTAR_RUNS")
    if v != null { runs = int(v) }
    stress_test(runs)
}
