import grid
from system import time
import system

INF = 2_000_000_000

fn a_star_grid_buffers_dc(
    rows: int,
    cols: int,
    start: tuple[int, int],
    goal: tuple[int, int],
    blocked,
    g_score,
    f_score,
    came_from,
    closed,
    open_heap) -> Optional[list[tuple[int, int]]] {

    grid.fill_i32(g_score, INF)
    grid.fill_i32(f_score, 0)
    grid.fill_i32(came_from, -1)
    grid.fill_u8(closed, 0)
    grid.heap_clear(open_heap)

    start_id = start[0] * cols + start[1]
    goal_id = goal[0] * cols + goal[1]
    goal_r, goal_c = goal

    if grid.test_blocked(blocked, start_id) or grid.test_blocked(blocked, goal_id) {
        return null
    }

    h0 = abs(start[0] - goal_r) + abs(start[1] - goal_c)
    grid.set_i32(g_score, start_id, 0)
    grid.set_i32(f_score, start_id, h0)
    grid.heap_push(open_heap, start_id, f_score)

    neighbors_delta = ((-1, 0), (1, 0), (0, -1), (0, 1))

    while grid.heap_len(open_heap) > 0 {
        current_f, current = grid.heap_pop(open_heap)
        if current_f != grid.get_i32(f_score, current) { continue }
        if grid.get_u8(closed, current) != 0 { continue }

        if current == goal_id {
            path = []
            while grid.get_i32(came_from, current) >= 0 {
                r, c = divmod(current, cols)
                path.push((r, c))
                current = grid.get_i32(came_from, current)
            }
            r, c = divmod(current, cols)
            path.push((r, c))
            return path[::-1]
        }

        grid.set_u8(closed, current, 1)
        r, c = divmod(current, cols)

        for dr, dc in neighbors_delta {
            nr, nc = r + dr, c + dc
            if !(0 <= nr < rows and 0 <= nc < cols) { continue }
            neighbor = nr * cols + nc
            if grid.test_blocked(blocked, neighbor) { continue }
            if grid.get_u8(closed, neighbor) != 0 { continue }

            tentative_g = grid.get_i32(g_score, current) + 1
            if tentative_g < grid.get_i32(g_score, neighbor) {
                grid.set_i32(came_from, neighbor, current)
                grid.set_i32(g_score, neighbor, tentative_g)
                h = abs(nr - goal_r) + abs(nc - goal_c)
                f = tentative_g + h
                grid.set_i32(f_score, neighbor, f)
                grid.heap_push(open_heap, neighbor, f_score)
            }
        }
    }
    return null
}

# Fused DC+Rust path: `while` stays in Datacode, body batches expansions via `grid.astar_step`.
fn a_star_grid_buffers_dc_fused(
    rows: int,
    cols: int,
    start: tuple[int, int],
    goal: tuple[int, int],
    blocked,
    g_score,
    f_score,
    came_from,
    closed,
    open_heap) -> Optional[list[tuple[int, int]]] {

    grid.fill_i32(g_score, INF)
    grid.fill_i32(f_score, 0)
    grid.fill_i32(came_from, -1)
    grid.fill_u8(closed, 0)
    grid.heap_clear(open_heap)

    start_id = start[0] * cols + start[1]
    goal_id = goal[0] * cols + goal[1]

    if grid.test_blocked(blocked, start_id) or grid.test_blocked(blocked, goal_id) {
        return null
    }

    h0 = abs(start[0] - goal[0]) + abs(start[1] - goal[1])
    grid.set_i32(g_score, start_id, 0)
    grid.set_i32(f_score, start_id, h0)
    grid.heap_push(open_heap, start_id, f_score)

    found = false
    while grid.heap_len(open_heap) > 0 {
        expansions, ok = grid.astar_step(
            rows, cols, goal, blocked, g_score, f_score, came_from, closed, open_heap, 50000)
        if ok { found = true; break }
        if expansions == 0 { break }
    }
    if !found { return null }

    current = goal_id
    path = []
    while grid.get_i32(came_from, current) >= 0 {
        r, c = divmod(current, cols)
        path.push((r, c))
        current = grid.get_i32(came_from, current)
    }
    r, c = divmod(current, cols)
    path.push((r, c))
    return path[::-1]
}

fn stress_test_native(num_runs: int, rows: int, cols: int, start, goal, blocked_cells: set) {
    n = rows * cols
    blocked = grid.alloc_u8(grid.bitmap_bytes(n), 0)
    for r, c in blocked_cells {
        grid.set_blocked(blocked, r * cols + c)
    }

    g_score = grid.alloc_i32(n, INF)
    f_score = grid.alloc_i32(n, 0)
    came_from = grid.alloc_i32(n, -1)
    closed = grid.alloc_u8(n, 0)

    total_time = 0.0
    success_count = 0

    for i in range(num_runs) {
        t0 = time.perf_counter()
        path = grid.astar(rows, cols, start, goal, blocked, g_score, f_score, came_from, closed)
        elapsed = time.perf_counter() - t0
        total_time += elapsed
        if path != null { success_count += 1 }
        if (i + 1) % 10 == 0 {
            print("Native grid.astar ${i+1}/${num_runs}, store_len=${grid.store_len()}, avg=${total_time/(i+1):.4f}s")
        }
    }

    if system.env.get("DC_TRIM_ARENA") != null {
        system.runtime.trim_allocator()
    }

    print("\n====== grid.astar (native) ======")
    print("Заблокировано: ${len(blocked_cells)}, прогонов: ${num_runs}")
    print("Успешно: ${success_count}, среднее: ${total_time/num_runs:.4f} сек.")
}

fn stress_test_dc(num_runs: int, rows: int, cols: int, start, goal, blocked_cells: set) {
    n = rows * cols
    blocked = grid.alloc_u8(grid.bitmap_bytes(n), 0)
    for r, c in blocked_cells {
        grid.set_blocked(blocked, r * cols + c)
    }
    g_score = grid.alloc_i32(n, INF)
    f_score = grid.alloc_i32(n, 0)
    came_from = grid.alloc_i32(n, -1)
    closed = grid.alloc_u8(n, 0)
    open_heap = grid.heap_alloc()

    total_time = 0.0
    use_fuse = system.env.get("DC_ASTAR_FUSE") != null
    for i in range(num_runs) {
        t0 = time.perf_counter()
        if use_fuse {
            path = a_star_grid_buffers_dc_fused(
                rows, cols, start, goal, blocked,
                g_score, f_score, came_from, closed, open_heap)
        } else {
            path = a_star_grid_buffers_dc(
                rows, cols, start, goal, blocked,
                g_score, f_score, came_from, closed, open_heap)
        }
        total_time += time.perf_counter() - t0
        if (i + 1) % 2 == 0 {
            print("DC buffers ${i+1}/${num_runs}, store_len=${grid.store_len()}, avg=${total_time/(i+1):.2f}s")
        }
    }
    print("\n====== A* на grid-буферах (DC цикл) ======")
    if use_fuse {
        print("Режим: DC while + grid.astar_step (fused)")
    } else {
        print("Режим: чистый DC (opcodes + grid.heap)")
    }
    print("Среднее: ${total_time/num_runs:.2f} сек.")
}

fn __main__() {
    rows, cols = 1000, 5000
    random_seed(42)

    blocked_cells = set()
    for _ in range(10000) {
        blocked_cells.add((random_int(0, rows - 1), random_int(0, cols - 1)))
    }
    start = (0, 0)
    goal = (559, 1234)
    blocked_cells.discard(start)
    blocked_cells.discard(goal)

    runs = 10
    v = system.env.get("DC_ASTAR_RUNS")
    if v != null { runs = int(v) }

    print("Единичный native grid.astar...")
    n = rows * cols
    blocked = grid.alloc_u8(grid.bitmap_bytes(n), 0)
    for r, c in blocked_cells { grid.set_blocked(blocked, r * cols + c) }
    g = grid.alloc_i32(n, INF)
    f = grid.alloc_i32(n, 0)
    p = grid.alloc_i32(n, -1)
    c = grid.alloc_u8(n, 0)
    path = grid.astar(rows, cols, start, goal, blocked, g, f, p, c)
    if path != null {
        print("Путь найден, длина = ${len(path)}")
    } else {
        print("Путь не найден")
    }

    if system.env.get("DC_ASTAR_DC_LOOP") != null {
        stress_test_dc(3, rows, cols, start, goal, blocked_cells)
    }

    stress_test_native(runs, rows, cols, start, goal, blocked_cells)
}
