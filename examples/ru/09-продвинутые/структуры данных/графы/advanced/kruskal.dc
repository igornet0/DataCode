# Алгоритм Краскала — минимальное остовное дерево (MST)
# Рёбра: (вес, u, v); вершины 0..n-1

from union_find import UnionFind

fn kruskal_mst(n: int, edges: list[tuple[float, int, int]]) -> tuple[float, list[tuple[int, int, float]]] {
    """
    Возвращает (суммарный вес MST, список рёбер MST как (u, v, weight)).
    """
    sorted_edges = sort(edges)
    uf = UnionFind(n)
    total = 0.0
    mst = []

    for e in sorted_edges {
        w, u, v = e[0], e[1], e[2]
        if uf.union(u, v) {
            total += w
            mst.push((u, v, w))
        }
    }

    if len(mst) != n - 1 {
        return (-1.0, [])
    }
    return (total, mst)
}

fn build_sample_graph() -> tuple[int, list[tuple[float, int, int]]] {
    """
    Классический пример из учебников (6 вершин).
    Ожидаемый вес MST = 16.
    """
    n = 6
    edges = [
        (4.0, 0, 1),
        (8.0, 0, 2),
        (7.0, 1, 2),
        (9.0, 1, 3),
        (10.0, 2, 3),
        (2.0, 2, 4),
        (1.0, 3, 4),
        (6.0, 3, 5),
        (5.0, 4, 5),
    ]
    return (n, edges)
}

fn __main__() {
    print("=== Kruskal MST ===")

    n, edges = build_sample_graph()
    weight, mst = kruskal_mst(n, edges)

    print("Вершин: ${n}, рёбер: ${len(edges)}")
    print("Вес MST: ${weight}")
    print("Рёбра MST:")
    for e in mst {
        print("  ${e[0]} — ${e[1]}  (w=${e[2]})")
    }

    # Граф-цикл: MST на 3 вершинах с треугольником
    n2 = 3
    edges2 = [(1.0, 0, 1), (2.0, 1, 2), (3.0, 0, 2)]
    w2, mst2 = kruskal_mst(n2, edges2)
    print("\nТреугольник: вес=${w2}, рёбер в MST=${len(mst2)} (ожид. 2, вес=3)")

    # Несвязный граф
    n3 = 4
    edges3 = [(1.0, 0, 1), (2.0, 2, 3)]
    w3, mst3 = kruskal_mst(n3, edges3)
    print("Несвязный граф: вес=${w3}, MST пуст=${len(mst3) == 0} (ожид. -1 и пусто)")
}
