# Алгоритм Фloyd-Warshall — все пары кратчайших путей за O(n³)
# Вход: матрица смежности dist[i][j] = вес или INF

INF = float(inf)

fn floyd_warshall(dist: list[list[float]]) -> list[list[float]] {
    n = len(dist)
    d = []
    for i in range(n) {
        row = []
        for j in range(n) { row.push(dist[i][j]) }
        d.push(row)
    }

    for k in range(n) {
        for i in range(n) {
            for j in range(n) {
                if d[i][k] != INF and d[k][j] != INF {
                    via = d[i][k] + d[k][j]
                    if via < d[i][j] { d[i][j] = via }
                }
            }
        }
    }
    return d
}

fn build_sample_matrix() -> list[list[float]] {
    return [
        [0.0, 3.0, INF, 7.0],
        [8.0, 0.0, 2.0, INF],
        [5.0, INF, 0.0, 1.0],
        [2.0, INF, INF, 0.0],
    ]
}

fn __main__() {
    print("=== Floyd-Warshall ===")

    initial = build_sample_matrix()
    result = floyd_warshall(initial)

    print("Исходная матрица:")
    for row in initial { print("  ${row}") }
    print("\nВсе пары кратчайших путей:")
    for row in result { print("  ${row}") }

    # 0→3 через 1: 0→1 (3) + 1→2 (2) + 2→3 (1) = 6
    expected = 6.0
    status = if result[0][3] == expected { "OK" } else { "FAIL" }
    print("\nТест dist[0][3]=6: ${status} (получено ${result[0][3]})")
}
