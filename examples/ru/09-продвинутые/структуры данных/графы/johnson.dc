# Алгоритм Джонсона — все пары кратчайших путей (возможны отрицательные веса без циклов)

import heapq

INF = float(inf)

fn bellman_ford_potential(n: int, edges: list[tuple[int, int, float]]) -> Optional[list[float]] {
    """Потенциалы h через виртуальную вершину s, соединённую со всеми."""
    dist = [0.0 for _ in range(n + 1)]
    ext_edges = []
    for e in edges { ext_edges.push(e) }
    for i in range(n) { ext_edges.push((n, i, 0.0)) }

    for _ in range(n) {
        updated = false
        for e in ext_edges {
            u, v, w = e[0], e[1], e[2]
            if dist[u] + w < dist[v] {
                dist[v] = dist[u] + w
                updated = true
            }
        }
        if !updated: break
    }

    for e in ext_edges {
        if dist[e[0]] + e[2] < dist[e[1]]: return null
    }
    return dist[:n]
}

fn dijkstra_reweight(adj: dict[int, list[tuple[int, float]]], n: int, source: int) -> dict[int, float] {
    dist = {}
    for i in range(n) { dist[i] = INF }
    dist[source] = 0.0
    heap = [(0.0, source)]

    while len(heap) > 0 {
        d, u = heapq.heappop(heap)
        if d > dist[u]: continue
        for edge in adj.get(u, []) {
            v, w = edge[0], edge[1]
            nd = d + w
            if nd < dist[v] {
                dist[v] = nd
                heapq.heappush(heap, (nd, v))
            }
        }
    }
    return dist
}

fn johnson_all_pairs(n: int, edges: list[tuple[int, int, float]]) -> Optional[list[list[float]]] {
    h = bellman_ford_potential(n, edges)
    if h == null: return null

    reweighted = {}
    for i in range(n) { reweighted[i] = [] }
    for e in edges {
        u, v, w = e[0], e[1], e[2]
        w2 = w + h[u] - h[v]
        if w2 < 0: return null
        reweighted[u].push((v, w2))
    }

    result = []
    for s in range(n) {
        d = dijkstra_reweight(reweighted, n, s)
        row = []
        for t in range(n) {
            if d[t] == INF { row.push(INF) }
            else { row.push(d[t] - h[s] + h[t]) }
        }
        result.push(row)
    }
    return result
}

fn __main__() {
    print("=== Johnson All-Pairs Shortest Paths ===")

    n = 4
    edges = [(0, 1, 3.0), (1, 2, -2.0), (2, 0, 1.0), (1, 3, 4.0)]
    dist = johnson_all_pairs(n, edges)

    print("матрица расстояний: ${dist}")
    status = if dist != null and dist[0][3] == 7.0 { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
