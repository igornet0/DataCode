# Segment Tree — range sum query и point update за O(log n)

cls SegmentTree {
    private:
        n: int
        tree: list[int]

    new SegmentTree(arr: list[int]) {
        this.n = len(arr)
        size = 4 * this.n
        this.tree = []
        for _ in range(size) { this.tree.push(0) }
        this._build(arr, 0, 0, this.n - 1)
    }

    private:
    fn _build(arr: list[int], node: int, left: int, right: int) {
        if left == right {
            this.tree[node] = arr[left]
            return
        }
        mid = (left + right) // 2
        left_child = 2 * node + 1
        right_child = 2 * node + 2
        this._build(arr, left_child, left, mid)
        this._build(arr, right_child, mid + 1, right)
        this.tree[node] = this.tree[left_child] + this.tree[right_child]
    }

    fn _update(node: int, left: int, right: int, index: int, value: int) {
        if left == right {
            this.tree[node] = value
            return
        }
        mid = (left + right) // 2
        if index <= mid {
            this._update(2 * node + 1, left, mid, index, value)
        } else {
            this._update(2 * node + 2, mid + 1, right, index, value)
        }
        this.tree[node] = this.tree[2 * node + 1] + this.tree[2 * node + 2]
    }

    fn _query(node: int, left: int, right: int, ql: int, qr: int) -> int {
        if ql > right or qr < left: return 0
        if ql <= left and right <= qr: return this.tree[node]
        mid = (left + right) // 2
        return this._query(2 * node + 1, left, mid, ql, qr)
            + this._query(2 * node + 2, mid + 1, right, ql, qr)
    }

    public:
    fn update(index: int, value: int) {
        this._update(0, 0, this.n - 1, index, value)
    }

    fn query(left: int, right: int) -> int {
        return this._query(0, 0, this.n - 1, left, right)
    }
}

fn range_max_queries(arr: list[int], queries: list[tuple[int, int]]) -> list[int] {
    """Демонстрация применения: суммы подмассивов по списку запросов."""
    st = SegmentTree(arr)
    answers = []
    for q in queries {
        answers.push(st.query(q[0], q[1]))
    }
    return answers
}

fn __main__() {
    print("=== Segment Tree (range sum) ===")

    arr = [1, 3, 5, 7, 9, 11]
    st = SegmentTree(arr)

    print("arr = ${arr}")
    print("query(1, 3) = ${st.query(1, 3)} (ожид. 15 = 3+5+7)")
    print("query(0, 5) = ${st.query(0, 5)} (ожид. 36)")

    st.update(2, 10)
    print("После update(2, 10): query(1,3) = ${st.query(1, 3)} (ожид. 20 = 3+10+7)")

    queries = [(0, 2), (2, 4), (1, 5)]
    updated_arr = [1, 3, 10, 7, 9, 11]
    answers = range_max_queries(updated_arr, queries)
    print("Пакет запросов ${queries}: ${answers}")

    expected = [14, 26, 40]
    status = if st.query(1, 3) == 20 and answers == expected { "OK" } else { "FAIL" }
    print("Тест: ${status}")
}
