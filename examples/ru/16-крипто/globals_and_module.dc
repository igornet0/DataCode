# Встроенные крипто-примитивы (глобально) и модуль `crypto` (Argon2id, bcrypt)

let d = sha256("hello")
print("sha256 len:", len(d))

let token = random_bytes(32)
print("token len:", len(token))

let r = random_int(1, 100)
print("random_int в [1,100]:", r)

from crypto import Argon2, bcrypt

let ah = Argon2.hash("mypassword")
print("Argon2 verify:", Argon2.verify("mypassword", ah))
print("Argon2 verify:", Argon2.verify("other", ah))

let bh = bcrypt.hash("mypassword")
print("bcrypt verify:", bcrypt.verify("mypassword", bh))
print("bcrypt verify:", bcrypt.verify("other", bh))