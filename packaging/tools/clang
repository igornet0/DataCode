#!/usr/bin/env bash
set -euo pipefail

# Wrapper to make clang accept cargo-xwin MSVC-style include args.
# cargo-xwin passes MSVC-style system includes as:
#   /imsvc <dir>
# clang treats `/imsvc` as a path, so translate to a portable clang flag:
#   -isystem <dir>
#
# Also supports concatenated form: /imsvc<dir>

out=()
i=0
argc=$#
while [ "$i" -lt "$argc" ]; do
  i=$((i + 1))
  a="${!i}"

  if [ "$a" = "/imsvc" ]; then
    if [ "$i" -lt "$argc" ]; then
      i=$((i + 1))
      out+=("-isystem" "${!i}")
    else
      out+=("$a")
    fi
    continue
  fi

  if [[ "$a" == /imsvc* ]]; then
    dir="${a#/imsvc}"
    if [ -n "$dir" ]; then
      out+=("-isystem" "$dir")
      continue
    fi
  fi

  out+=("$a")
done

exec /usr/bin/clang "${out[@]}"

