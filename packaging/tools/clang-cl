#!/usr/bin/env bash
set -euo pipefail

# Wrapper to provide a clang-cl compatible driver on Debian images
# (some images don't ship a /usr/bin/clang-cl binary).
#
# Also fixes cargo-xwin's split /imsvc args:
#   /imsvc <dir>  ->  /imsvc<dir>
#
# We implement clang-cl via: clang --driver-mode=cl

out=()
i=0
argc=$#

while [ "$i" -lt "$argc" ]; do
  i=$((i + 1))
  a="${!i}"

  if [ "$a" = "/imsvc" ]; then
    if [ "$i" -lt "$argc" ]; then
      i=$((i + 1))
      dir="${!i}"
      out+=("/imsvc${dir}")
    else
      out+=("$a")
    fi
    continue
  fi

  out+=("$a")
done

exec /usr/bin/clang --driver-mode=cl "${out[@]}"

