from database_engine import engine

# SQLite (файловая БД)
sqlite_url = "sqlite:///mydb.sqlite"
sqlite_engine = engine(sqlite_url, echo=True, echo_pool=False, pool_size=5, max_overflow=10)

# PostgreSQL
postgres_url = "postgresql://user:password@localhost:5432/mydatabase"
postgres_engine = engine(postgres_url, echo=True, echo_pool=True, pool_size=10, max_overflow=20)

# MySQL / MariaDB
mysql_url = "mysql+pymysql://user:password@localhost:3306/mydatabase"
mysql_engine = engine(mysql_url, echo=False, echo_pool=True, pool_size=5, max_overflow=10)

# Microsoft SQL Server
mssql_url = "mssql+pyodbc://user:password@localhost:1433/mydatabase?driver=ODBC+Driver+17+for+SQL+Server"
mssql_engine = engine(mssql_url, echo=True, echo_pool=False, pool_size=5, max_overflow=10)

# Oracle
oracle_url = "oracle+cx_oracle://user:password@localhost:1521/orclpdb1"
oracle_engine = engine(oracle_url, echo=False, echo_pool=False, pool_size=5, max_overflow=5)

# No sql
# MongoDB
mongodb_url = "mongodb://user:password@localhost:27017/mydatabase"
mongodb_engine = engine(mongodb_url, echo=False, echo_pool=False, pool_size=10, max_overflow=50)

# CouchDB
couchdb_url = "http://user:password@localhost:5984/mydatabase"
couchdb_engine = engine(couchdb_url, echo=True, echo_pool=False, pool_size=5, max_overflow=10)

# Redis
redis_url = "redis://localhost:6379/0"
redis_engine = engine(redis_url, echo=False, echo_pool=False, pool_size=10, max_overflow=20)

# Memcached
memcached_url = "memcached://localhost:11211"
memcached_engine = engine(memcached_url, echo=False, echo_pool=False, pool_size=5, max_overflow=5)

# Neo4j
neo4j_url = "neo4j://user:password@localhost:7687"
neo4j_engine = engine(neo4j_url, echo=True, echo_pool=False, pool_size=5, max_overflow=10)

# ArangoDB
arangodb_url = "http://user:password@localhost:8529/_db/mydatabase"
arangodb_engine = engine(arangodb_url, echo=True, echo_pool=True, pool_size=5, max_overflow=10)

# ClickHouse
clickhouse_url = "clickhouse://user:password@localhost:9000/mydatabase"
clickhouse_engine = engine(clickhouse_url, echo=False, echo_pool=False, pool_size=10, max_overflow=20)

# Cassandra
cassandra_url = "cassandra://user:password@localhost:9042/mykeyspace"
cassandra_engine = engine(cassandra_url, echo=True, echo_pool=True, pool_size=5, max_overflow=10)

# InfluxDB
influxdb_url = "influxdb://user:password@localhost:8086/mydatabase"
influxdb_engine = engine(influxdb_url, echo=False, echo_pool=False, pool_size=5, max_overflow=10)

