
cls Data {
    private:
        id: int
        balance: float = 0.0

    public:
        name: str
        value: int

        new Data(id, name, value) {
            this.id = id
            this.name = name
            this.value = value
        }

        new Data(id, balance, name, value) {
            this.id = id
            this.balance = balance
            this.name = name
            this.value = value
        }

        #new Data(id, name, value) : this(id, 0.0, name, value) {}

        fn deposit(amount: float) -> null {
            this.balance += amount
        }

        fn getBalance() -> float {
            return this.balance
        }  
}
