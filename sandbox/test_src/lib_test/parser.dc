
cls Parser {
    private:
        url: str

    public:
        driver: null = null

        new Parser(url) {
            this.url = url
        }

        new Parser(url, driver) {
            this.url = url
            this.driver = driver
        }

        fn run() -> null {
            print("URL: ", url)
        }

        fn getUrl() -> float {
            return this.url
        }  
}
