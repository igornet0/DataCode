from system import time
fn __main__() {
    t0 = time.perf_counter()
    parts = []
    total = 0
    for i in range(300000) {
        s = "item_" + str(i)
        total += len(s)
        if i % 10 == 0 {
            parts.push(s)
        }
    }
    joined = join(parts, ",")
    t1 = time.perf_counter()
    print("RESULT s07 ${total} ${len(joined)} ${t1 - t0:.4f}")
}
