from database_engine import engine, Column, MetaData, now_call, select, SQLEnum
from database_engine.validators import min_length, max_length, length_between, regex, email, url, username, password_policy, one_of, min_value, max_value, range_value, custom  


from crypto import Argon2

fn camel_case_to_snake_case(input_str: str) -> str {
    """
    >>> camel_case_to_snake_case("SomeSDK")
    'some_sdk'
    >>> camel_case_to_snake_case("RServoDrive")
    'r_servo_drive'
    >>> camel_case_to_snake_case("SDKDemo")
    'sdk_demo'
    """
    chars = []
    for c_idx, char in enum(input_str) {
        if c_idx and char.isupper() {
            nxt_idx = c_idx + 1
            # idea of the flag is to separate abbreviations
            # as new words, show them in lower case
            flag = nxt_idx >= len(input_str) or input_str[nxt_idx].isupper()
            prev_char = input_str[c_idx - 1]
            if !(prev_char.isupper() and flag) { 
                chars.push("_")
            }
        }
        chars.push(char.lower())    
    } 
    return "".join(chars)
}

print(camel_case_to_snake_case("SomeSDK"))
print(camel_case_to_snake_case("RServoDrive"))
print(camel_case_to_snake_case("SDKDemo"))

naming_convention = {
        "ix": "ix_%(column_0_label)s",
        "uq": "uq_%(table_name)s_%(column_0_N_name)s",
        "ck": "ck_%(table_name)s_%(constraint_name)s",
        "fk": "fk_%(table_name)s_%(column_0_name)s_%(referred_table_name)s",
        "pk": "pk_%(table_name)s"
    }

cls UserRole(SQLEnum) { 
    ADMIN = "admin"
    USER = "user"
    MODERATOR = "moder"
}

@Abstract
cls Base(Table) {

    created: Column[date] = Column(date, default=now_call)
    updated: Column[date] = Column(date, default=now_call, onupdate=now_call)

    metadata = MetaData(
        schema = "public",
        quote_schema=null,
        naming_convention=naming_convention,
        info={
            "app": "billing",
            "version": 1
        }
    )

    fn __tablename__(@class) -> str {
        return "${camel_case_to_snake_case(@class.name)}s"
    }
}

cls User(Base) {

    id: Column[int] = Column(int, primary_key=true, autoincrement=true)
    login: Column[str] = Column(str[50], unique=true)
    name: Column[str] = Column(str[50])
    password: Column[str] = Column(str[100], validators=[min_length(9)], transform=Argon2.hash)

    email: Column[str] = Column(str[50], unique=true)

    balance: Column[float] = Column(float, default=0)

    role: Column[UserRole] = Column(UserRole, default=UserRole.USER)

    is_active: Column[bool] = Column(bool, default=true)
    is_superuser: Column[bool] = Column(bool, default=false)

    is_verified: Column[bool] = Column(bool, default=false)

    is_2fa_enabled: Column[bool] = Column(bool, default=false)
    is_2fa_verified: Column[bool] = Column(bool, default=false)
    
    avatar: Column[str | null] = Column(str[255], nullable=true, default=null)
}


# SQLite (файловая БД)
sqlite_url = "sqlite:///./test_db.sqlite"
sqlite_engine = engine(sqlite_url, echo=true, echo_pool=false, pool_size=5, max_overflow=10)

# Connect (for SQLite, returns same engine)
conn = sqlite_engine.connect()
print("Connected:", conn)

# Create table
conn.run(Base.metadata.create_all)
print("Table created")

# Insert
conn.run(User(name="Alice", login="login1", email="email1", password="password_hash1"))
conn.run(User(name="Bob", login="login2", email="email2", password="password_hash2"))
conn.run(User(name="Alice", login="login3", email="email3", password="hash1"))
print("Inserted rows")

# Query
t = conn.run(select(User)) # t = conn.query("SELECT * FROM users", [])
print("Query result:", t)
print("Rows:", t.rows)
