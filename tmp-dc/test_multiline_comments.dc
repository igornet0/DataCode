"""
This is a multiline comment at the top of the file.
It demonstrates the new triple-quote syntax for documentation.
"""

fn add(a, b) {
    """
    Adds two numbers together.
    
    Parameters:
        a - first number
        b - second number
    
    Returns:
        The sum of a and b
    """
    return a + b
}

"""
Testing the function below
"""
let result = add(5, 3)
print("Result:", result)

fn factorial(n) {
    """
    Calculate factorial of n
    Examples:
        >>> factorial(5)
        120
    """
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

let fact5 = factorial(5)
print("Factorial of 5:", fact5)

