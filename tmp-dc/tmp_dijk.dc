import heapq
graph = {}
graph[0] = [(1, 1.0)]
for edge in graph.get(0, []) {
    print("edge=", edge, typeof(edge))
    print(edge[0], edge[1])
}
h = [(0.0, 0)]
d, u = heapq.heappop(h)
print("u=", u)
for edge in graph.get(u, []) {
    print("edge2=", edge)
    v, w = edge[0], edge[1]
    print(v, w)
}
