import heapq
INF = float(inf)
fn dijkstra(graph, n, source) {
    dist = {}
    parent = {}
    for i in range(n) {
        dist[i] = INF
        parent[i] = null
    }
    dist[source] = 0.0
    heap = [(0.0, source)]
    while len(heap) > 0 {
        d, u = heapq.heappop(heap)
        print("pop d=", d, "u=", u, typeof(u))
        if d > dist[u]: continue
        for edge in graph.get(u, []) {
            print(" edge=", edge, typeof(edge))
            v, w = edge[0], edge[1]
            print(" v=", v, "w=", w)
        }
        break
    }
}
graph = {}
graph[0] = [(1, 4.0), (2, 1.0)]
dijkstra(graph, 5, 0)
