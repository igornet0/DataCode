import heapq
h = []
heapq.heappush(h, (1, (0, 0)))
heapq.heappush(h, (2, (1, 0)))
heapq.heappush(h, (3, (2, 0)))
print("pop=", heapq.heappop(h))

cls PQ {
    public:
        heap: list[tuple]
    new PQ() { this.heap = [] }
    fn push(p, item) { heapq.heappush(this.heap, (p, item)) }
}
pq = PQ()
pq.push(1, (0, 0))
pq.push(2, (1, 0))
print("class pop=", heapq.heappop(pq.heap))
