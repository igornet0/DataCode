import heapq
cls PQ {
    heap: list[tuple]
    new PQ() { this.heap = [] }
    fn push(p, item) { heapq.heappush(this.heap, (p, item)) }
    fn pop_wp() { return heapq.heappop(this.heap) }
}
lists = [[1, 4, 7], [2, 5, 8], [3, 6, 9]]
pq = PQ()
for i in range(len(lists)) {
    if len(lists[i]) > 0 { pq.push(lists[i][0], (i, 0)) }
}
result = []
while len(pq.heap) > 0 {
    item = pq.pop_wp()
    print("item=", item)
    val = item[1]
    list_idx, elem_idx = val[0], val[1]
    result.push(lists[list_idx][elem_idx])
    next_idx = elem_idx + 1
    if next_idx < len(lists[list_idx]) {
        pq.push(lists[list_idx][next_idx], (list_idx, next_idx))
    }
}
print("result=", result)
