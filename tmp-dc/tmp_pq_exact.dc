import heapq
cls PriorityQueue {
    private:
        heap: list[tuple]
    new PriorityQueue() {
        this.heap = []
    }
    public:
    fn push(priority, item) {
        heapq.heappush(this.heap, (priority, item))
    }
    fn pop() {
        if this.is_empty(): return null
        entry = heapq.heappop(this.heap)
        return entry[1]
    }
    fn is_empty() -> bool {
        return len(this.heap) == 0
    }
}
fn __main__() {
pq = PriorityQueue()
tasks = [(5, "low"), (1, "critical"), (3, "medium"), (1, "urgent")]
for t in tasks { pq.push(t[0], t[1]) }
order = []
while !pq.is_empty() {
    order.push(pq.pop())
}
print("order=", order)
}
