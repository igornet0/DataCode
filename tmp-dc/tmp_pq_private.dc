import heapq
cls PQ {
    private:
        heap: list[tuple]
    new PQ() { this.heap = [] }
    public:
    fn push(p, item) { heapq.heappush(this.heap, (p, item)) }
    fn pop() { return heapq.heappop(this.heap)[1] }
    fn is_empty() -> bool { return len(this.heap) == 0 }
}
pq = PQ()
pq.push(1, "critical")
pq.push(3, "medium")
order = []
while !pq.is_empty() { order.push(pq.pop()) }
print("order=", order)
