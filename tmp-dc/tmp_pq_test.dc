import heapq
cls PQ {
    heap: list[tuple]
    new PQ() { this.heap = [] }
    fn push(p, item) { heapq.heappush(this.heap, (p, item)) }
    fn pop() { return heapq.heappop(this.heap)[1] }
}
pq = PQ()
for t in [(5, "low"), (1, "critical"), (3, "medium"), (1, "urgent")] {
    pq.push(t[0], t[1])
}
order = []
while len(pq.heap) > 0 { order.push(pq.pop()) }
print("order=", order)
