fn build_prefix_hash(s, base, modulus) {
    n = len(s)
    prefix = [0 for _ in range(n + 1)]
    pow_b = [1 for _ in range(n + 1)]
    for i in range(n) {
        prefix[i + 1] = (prefix[i] * base + ord(s[i])) % modulus
        pow_b[i + 1] = (pow_b[i] * base) % modulus
    }
    return (prefix, pow_b)
}
fn substring_hash(prefix, pow_b, left, right, modulus) {
    length = right - left + 1
    h = (prefix[right + 1] - prefix[left] * pow_b[length]) % modulus
    return (h + modulus) % modulus
}
s = "abracadabra"
pref, pw = build_prefix_hash(s, 911382323, 1000000007)
h1 = substring_hash(pref, pw, 0, 3, 1000000007)
h2 = substring_hash(pref, pw, 7, 10, 1000000007)
print("h1=", h1, "h2=", h2, "eq=", h1 == h2)
