# ===== Вкладка 1 =====
# ===== Вкладка 2 =====
credit = 580_000
balance = 4820
procent = 6962
procetc_d = 55/365
days = 31
now_d = 8
print("55%")
print("${credit=}, ${procetc_d=}")

days_d = 10

for d in range(days_d) {
    
    proc = (credit - balance + procent) * procetc_d / 100
    procent += proc

    print("${d + now_d + 1}: ${proc=} ${procent=}")

}

balance += 154_000

for d in range(days - now_d - days_d) {
    
    proc = (credit - balance + procent) * procetc_d / 100
    procent += proc

    #print("${d + now_d + days_d + 1}: ${proc=} ${procent=}")

}
#print("-"*20)
mounth_end = 0
mounth_p = 25000

while (balance - credit) <= 0 {

    balance += mounth_p - procent
    procent = 0

for d in range(30){
    
    proc = (credit - balance + procent) * procetc_d / 100
    procent += proc
}
mounth_end += 1
#print("${mounth_end}: ${balance=} ${procent=}")

}

print("years: ${mounth_end/12}")
print("-"*20)



# ===== Вкладка 2 =====
# ===== Вкладка 2 =====
#credit = 590_000
credit = 606_055 

balance = 156_000 + 16_055
procent = 0
procetc_d = 27.99/365
procetc_m = 27.99/12
credit -= balance 
credit += 156_000

print("27.99%")
print("${credit=}, ${procetc_d=}")

mounth_end = 0
mounth_p = 20000
procent_suma = 0 
while credit >= 0 {

procent += 30 * (credit * procetc_d / 100)
credit -= mounth_p + procent
procent_suma += procent
mounth_end += 1
print("${mounth_end}: ${credit=} ${procent=}")
procent = 0


}

print("years: ${mounth_end/12} ${procent_suma=}")
print("-"*20)




